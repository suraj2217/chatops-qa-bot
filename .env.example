# Slack app > Basic Information > App Credentials > Signing Secret
SLACK_SIGNING_SECRET=replace-with-your-slack-signing-secret

# Local SQLite database file (relative paths are resolved from the project root)
DATABASE_PATH=data/chatops.sqlite3

# SauceDemo test target and standard practice account
SAUCEDEMO_BASE_URL=https://www.saucedemo.com/
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

# Maximum wall-clock time for one UI suite run
TEST_RUN_TIMEOUT_SECONDS=900
